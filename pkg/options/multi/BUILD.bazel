go_test(
    name = "go_default_test",
    srcs = [
        "multi_scope_test.go",
        "multi_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//pkg/converter:go_default_library",
        "//pkg/options:go_default_library",
        "//pkg/testutil:go_default_library",
    ],
)
